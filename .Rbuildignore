# RStudio / IDE
^.*\.Rproj$
^\.Rproj\.user$
^\.vscode$

# renv
^renv$
^renv\.lock$

# docs
^docs$
^Readme\.Rmd$
^vignettes/introduction_cache$

# GitHub / CI
^\.github$
^CONTRIBUTING\.md$
^CODE_OF_CONDUCT\.md$

# Hidden config files (development only)
^\.lintr$
^\.editorconfig$
^\.claude$
# A git worktree's .git is a file, not a directory, so R CMD build does not
# drop it on its own.
^\.git$

# R CMD build artifacts
^doc$
^Meta$

# Development helpers
^dev$
^paper$
^LICENSE$

# ---- Legacy test fixtures and the bitwise compliance tier ----
# ---- GitHub CI only, not shipped to CRAN ----
^tests/testthat/fixtures$
^tests/compliance$
^tests/fixtures$

# ---- C/C++ build artifacts (REQUIRED) ----
^src/.*\.o$
^src/.*\.so$
^src/.*\.dll$

# ---- Generated build files ----
^src/Makevars$
^src/Makevars\.win$
^src/sources\.mk$
